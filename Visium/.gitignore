# R/RStudio state
.RData
.Rhistory
.Rproj.user/
.Renviron
renv/library/
renv/staging/

# Python state
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Raw and derived data are distributed separately
data/raw/**
!data/raw/README.md
data/derived/**
!data/derived/README.md
data/reference/**
!data/reference/README.md

# Generated tables are versioned; figure PDFs remain local
results/figures/**
!results/figures/.gitkeep

# Large scientific file types and crash dumps
*.rds
*.RDS
*.qs
*.qs2
*.h5
*.h5ad
*.loom
*.npy
*.tif
*.tiff
*.tar.gz
core
core.*

# Lightweight reproducibility inputs and generated R result objects
!data/derived/
!data/derived/README.md
!data/derived/result.dge.rds
!data/derived/pseudotime/
!data/derived/pseudotime/*.csv
!data/reference/
!data/reference/gene_sets.rds
!data/reference/luminal_surface_annotations.csv
!results/tables/*.rds

# Rendered notebook output
Rmd/*_files/
Rmd/*_cache/
Rmd/*.html
!Rmd/Clean_plotting.html
!Rmd/Supple_plotting.html
Rmd/*.pdf

# Internal validation notes
REPRODUCIBILITY_TESTING.md
TESTING.md

.DS_Store
